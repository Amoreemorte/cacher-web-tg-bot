# ===========================================================================
# Конфигурация приложения. Скопируйте в .env и заполните реальные значения:
#   cp .env.example .env
# Файл .env не попадает в Git (см. .gitignore).
# ===========================================================================

# Токен Telegram-бота (обязателен для сервиса bot; получайте у @BotFather).
TELEGRAM_BOT_TOKEN=

# --- LLM (основной провайдер, OpenAI-совместимый Chat Completions API) ---
LLM_PRIMARY_URL=https://api.groq.com/openai/v1/chat/completions
LLM_PRIMARY_KEY=
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile

# --- LLM (резервный провайдер; используется при недоступности основного) ---
LLM_BACKUP_URL=
LLM_BACKUP_KEY=
LLM_BACKUP_MODEL=

# Таймаут запроса к LLM (секунды), повторы и размер ответа.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SEC=2
LLM_MAX_TOKENS=512

# --- REST API (сервис api) ---
HTTP_ADDR=:8080
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
CORS_ALLOWED_ORIGINS=*

# Путь к файлу SQLite. Оба сервиса (api и bot) должны указывать один и тот же
# файл в общем volume: /data/expenses.db
DB_PATH=/data/expenses.db

DEBUG=false

# Порт хоста, на котором открывается веб-панель (Nginx).
WEB_PORT=8080
